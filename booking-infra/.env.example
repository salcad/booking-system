# Copy to .env next to docker-compose.yml and fill in. .env is gitignored.

# --- database ---------------------------------------------------------------
POSTGRES_DB=booking
POSTGRES_USER=booking
# Required, no default. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- web --------------------------------------------------------------------
# Port the UI publishes on. Use 127.0.0.1:8073 when running the tls profile, so
# only Caddy can reach the container.
WEB_PORT=8073

# --- tls profile (optional) -------------------------------------------------
# Needed only for `docker compose --profile tls up -d`. The domain's A record
# must already point at this VPS or the certificate order will fail.
PUBLIC_DOMAIN=
ACME_EMAIL=

# --- tuning (optional) ------------------------------------------------------
IMAGE_TAG=latest
API_LOG_LEVEL=INFO
BOOKING_HOLD_DURATION=PT10M
BOOKING_TRIAL_PRICE_CENTS=4900
API_MEMORY=768m
WEB_MEMORY=512m
